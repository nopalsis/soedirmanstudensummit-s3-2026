---
import Layout from '../../layouts/Layout.astro';
import PaguyubanCard from '../../components/PaguyubanCard.astro';
import paguyubanData from '../../lib/data/paguyuban';

const categories = Array.from(new Set(paguyubanData.map(org => org.location))).sort();
---

<Layout title="Paguyuban - Soedirman Student Summit 2026">
	<main class="min-h-screen bg-gradient-to-b from-[#1E4B82] to-[#0F1F52] relative">
		<!-- Hero Section -->
		<section class="relative w-full h-[calc(100vh-var(--nav-height))] flex items-center justify-center bg-gradient-to-b from-[#1E4B82] to-[#0F1F52] bg-cover bg-center px-4 sm:px-6 overflow-visible" style="background-image: url('/images/elements/bgbatik-sambutan.webp');">
			<div class="absolute inset-0 bg-gradient-to-b from-[#1E4B82] to-[#0F1F52] opacity-95 pointer-events-none z-0"></div>
			<div class="absolute top-1/3 -translate-y-1/2 left-1/2 -translate-x-1/2 w-full z-10">
				<div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8">
					<div class="text-center mb-12" data-aos="fade-down" data-aos-duration="800">
						<h1 class="gradient-text-title font-junigarden-swash text-3xl xs:text-4xl sm:text-5xl md:text-6xl lg:text-6xl drop-shadow-[0_2px_0_rgba(0,0,0,0.2)] mb-6 leading-tight text-stroke-gold">
							Paguyuban Mahasiswa Daerah
						</h1>
						<p class="text-white text-sm md:text-base max-w-3xl mx-auto leading-relaxed">
							Organisasi kedaerahan yang menyatukan mahasiswa berdasarkan asal daerah dan budaya lokal, menjadi wadah silaturahmi, pelestarian identitas, dan pengembangan diri di tanah rantau.
						</p>
					</div>

					<!-- Search & Filter Bar -->
					<div class="flex flex-col sm:flex-row gap-4 max-w-4xl mx-auto" data-aos="fade-up" data-aos-duration="800" data-aos-delay="200">
					<!-- Search Bar -->
					<div class="flex-1">
						<div class="relative">
							<svg
								class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
								></path>
							</svg>
							<input
								id="searchInput"
								type="text"
								placeholder="Cari paguyuban yang kamu minati..."
								class="w-full pl-12 pr-4 py-3 rounded-lg border border-s3-gold/20 bg-white text-black placeholder-gray-400 focus:outline-none focus:border-s3-gold transition-colors"
							/>
						</div>
					</div>

					<!-- Filter Dropdown -->
					<div class="relative z-[9999] w-full sm:w-auto">
							<button
								id="filterBtn"
								class="w-full sm:w-50 px-6 py-3 rounded-lg border border-s3-gold/20 bg-white text-black font-medium hover:border-s3-gold transition-colors flex items-center justify-center gap-2"
							>
								Semua Lokasi
								<svg class="w-5 h-5 text-black filter-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<polyline points="6 9 12 15 18 9"></polyline>
								</svg>
							</button>

						<!-- Dropdown Menu -->
							<div
								id="filterMenu"
								class="hidden absolute right-0 mt-2 w-full sm:w-50 rounded-lg border border-s3-gold/20 bg-gradient-to-br from-s3-blue/90 to-s3-deep-blue/90 backdrop-blur-sm shadow-xl z-[9999]"
							>
								<button
									data-filter="all"
									class="filter-option w-full text-left px-6 py-3 text-white hover:bg-s3-gold/10 transition-colors first:rounded-t-lg font-medium"
								>
									Semua Lokasi
								</button>
								{categories.map(category => (
									<button
										data-filter={category}
										class="filter-option w-full text-left px-6 py-3 text-white hover:bg-s3-gold/10 transition-colors capitalize"
									>
										{category}
									</button>
								))}
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Content Section -->
		<section class="py-20 pb-20 bg-cover bg-center relative z-0 overflow-visible" style="background-color: #76A3ED; background-image: url('/images/elements/bgbatik.webp');">
			<img src="/images/elements/awanbirukuning.png" alt="Awan" class="absolute top-2 left-0 right-0 w-1/2 object-cover object-bottom pointer-events-none z-30" style="transform: translateY(-50%);" />
			<img src="/images/elements/ornament1.png" alt="Ornament" class="absolute top-3 left-1/2 -translate-x-1/2 pointer-events-none z-10" style="transform: translateY(-60%) scale(0.9);" />
			<img src="/images/elements/awanbirukuning.png" alt="Awan" class="absolute top-2 left-0 right-0 w-1/2 object-cover object-bottom pointer-events-none z-30 ml-auto" style="transform: translateY(-50%) scaleX(-1);" />
			<div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 relative z-40">

			<!-- Grid -->
			<div id="paguyubanGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative z-40 justify-items-center md:justify-items-start" data-aos="fade-up" data-aos-duration="800" data-aos-delay="400">
				{paguyubanData.map((org, index) => (
					<div
						data-name={org.name}
						data-description={org.description}
						data-location={org.location}
						class="paguyuban-card-wrapper"
						data-aos="fade-up"
						data-aos-duration="600"
						data-aos-delay={100 + (index % 4) * 100}
					>
					<PaguyubanCard
						image={org.image}
						imageAlt={org.name}
						title={org.name}
						description={org.description}
						location={org.location}
						href={`/paguyuban/${org.name.toLowerCase().replace(/\s+/g, '-').replace(/[()]/g, '')}/`}
					/>
					</div>
				))}
			</div>

				<!-- Empty State -->
				<div id="emptyState" class="hidden text-center py-12" data-aos="fade-in" data-aos-duration="600">
					<p class="text-gray-400">Tidak ada paguyuban yang sesuai dengan pencarian Anda</p>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		background-attachment: fixed;
	}

	.filter-svg {
		transition: transform 0.3s ease;
	}

	.filter-svg.open {
		transform: rotate(180deg);
	}
</style>

<script>
	const searchInput = document.getElementById('searchInput') as HTMLInputElement;
	const filterBtn = document.getElementById('filterBtn') as HTMLButtonElement;
	const filterMenu = document.getElementById('filterMenu') as HTMLElement;
	const filterOptions = document.querySelectorAll('.filter-option');
	const paguyubanCardWrappers = document.querySelectorAll('.paguyuban-card-wrapper');
	const emptyState = document.getElementById('emptyState');
	const paguyubanGrid = document.getElementById('paguyubanGrid');

	let currentFilter = 'all';

	filterBtn.addEventListener('click', () => {
		filterMenu.classList.toggle('hidden');
		const svg = filterBtn.querySelector('svg');
		if (svg) {
			svg.classList.toggle('open');
		}
	});

	document.addEventListener('click', (e) => {
		if (!filterBtn.contains(e.target as Node) && !filterMenu.contains(e.target as Node)) {
			filterMenu.classList.add('hidden');
			const svg = filterBtn.querySelector('svg');
			if (svg) {
				svg.classList.remove('open');
			}
		}
	});

	function filterPaguyuban() {
		const searchTerm = searchInput.value.toLowerCase();
		let visibleCount = 0;

		paguyubanCardWrappers.forEach(wrapper => {
			const name = wrapper.getAttribute('data-name')?.toLowerCase() || '';
			const description = wrapper.getAttribute('data-description')?.toLowerCase() || '';
			const location = wrapper.getAttribute('data-location') || '';

			const matchesSearch = name.includes(searchTerm) || description.includes(searchTerm);
			const matchesFilter = currentFilter === 'all' || location === currentFilter;
			const shouldShow = matchesSearch && matchesFilter;

			if (shouldShow) {
				wrapper.classList.remove('hidden');
				visibleCount++;
			} else {
				wrapper.classList.add('hidden');
			}
		});

		if (visibleCount === 0) {
			paguyubanGrid!.classList.add('hidden');
			emptyState!.classList.remove('hidden');
		} else {
			paguyubanGrid!.classList.remove('hidden');
			emptyState!.classList.add('hidden');
		}
	}

	searchInput.addEventListener('input', filterPaguyuban);

	filterOptions.forEach(option => {
		option.addEventListener('click', () => {
			const filter = option.getAttribute('data-filter') || 'all';
			const label = option.textContent || 'Semua Lokasi';
			
			const capitalizedLabel = label.trim().charAt(0).toUpperCase() + label.trim().slice(1).toLowerCase();
			
			// Remove active class from all options
			filterOptions.forEach(opt => {
				opt.classList.remove('bg-s3-gold/20', 'text-s3-gold');
			});
			
			// Add active class to selected option
			option.classList.add('bg-s3-gold/20', 'text-s3-gold');
			
			// Update text tanpa menghapus SVG
			const textNode = filterBtn.childNodes[0];
			if (textNode && textNode.nodeType === Node.TEXT_NODE) {
				textNode.textContent = capitalizedLabel + ' ';
			} else {
				filterBtn.insertBefore(document.createTextNode(capitalizedLabel + ' '), filterBtn.firstChild);
			}
			
			filterMenu.classList.add('hidden');
			currentFilter = filter;
			filterPaguyuban();
		});
	});
</script>
