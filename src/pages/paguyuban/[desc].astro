---
import Layout from '../../layouts/Layout.astro';
import Divider from '../../components/divider/Divider.astro';
import paguyubanData from '../../lib/data/paguyuban';

export async function getStaticPaths() {
	return paguyubanData.map(org => ({
		params: { desc: org.name.toLowerCase().replace(/\s+/g, '-').replace(/[()]/g, '') },
		props: { paguyuban: org }
	}));
}

interface Props {
	paguyuban: typeof paguyubanData[0];
}

const { paguyuban } = Astro.props;
---

<Layout title={`${paguyuban.name} - Soedirman Student Summit 2026`}>
	<main class="min-h-screen bg-gradient-to-b from-[#1E4B82] to-[#0F1F52] relative">
		<!-- Hero Section -->
		<section class="relative w-full h-[calc(100vh-var(--nav-height))] flex items-center justify-center bg-gradient-to-b from-[#1E4B82] to-[#0F1F52] bg-cover bg-center px-4 sm:px-6 overflow-visible" style="background-image: url('/images/elements/bgbatik-sambutan.webp');">
			<div class="absolute inset-0 bg-gradient-to-b from-[#1E4B82] to-[#0F1F52] opacity-95 pointer-events-none z-0"></div>
			<div class="absolute bottom-0 left-0 right-0 h-64 bg-gradient-to-t from-[#FEDE82]/80 to-transparent pointer-events-none z-20"></div>
			<div class="absolute bottom-0 left-0 right-0 pointer-events-none overflow-visible z-10">
				<img
					src="/images/elements/element2.webp"
					alt="Background Elements"
					class=""
				/>
			</div>
			<div class="absolute top-8 left-1/2 -translate-x-1/2 w-full z-50 px-4 sm:px-6 md:px-8 pointer-events-auto">
				<div class="max-w-6xl mx-auto">
					<!-- Back Button -->
					<a
						href="/paguyuban"
						class="inline-flex items-center gap-2 text-s3-gold hover:text-white transition-colors pointer-events-auto"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
						</svg>
						Kembali
					</a>
				</div>
			</div>

			<div class="absolute top-2/5 -translate-y-1/2 left-1/2 -translate-x-1/2 w-full z-10">
				<div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8">

					<!-- Hero Content -->
					<div class="flex flex-col md:flex-row items-center justify-center md:gap-12" data-aos="fade-up" data-aos-duration="800">
					<!-- Logo -->
					<div class="h-32 w-32 sm:h-40 sm:w-40 md:h-48 md:w-48 flex-shrink-0" data-aos="fade-right" data-aos-duration="800" data-aos-delay="200">
						<img
							src={paguyuban.image}
							alt={paguyuban.name}
							class="h-full w-full object-contain"
						/>
					</div>

					<!-- Info -->
					<div class="flex-1" data-aos="fade-left" data-aos-duration="800" data-aos-delay="200">
						<h1 class="text-2xl sm:text-3xl md:text-5xl font-bold text-white mb-3">
							{paguyuban.name}
						</h1>

						<!-- Badge lokasi -->
						<div class="mb-6">
							<span class="group inline-flex items-center gap-2 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-s3-gold bg-s3-gold/5 border border-s3-gold/30 rounded-full backdrop-blur-sm sm:px-4 sm:py-1.5">
								<span class="h-1.5 w-1.5 rounded-full bg-s3-gold"></span>
								{paguyuban.location}
							</span>
						</div>

						<p class="text-sm md:text-base text-gray-300 mb-6 leading-tight text-justify">
							{paguyuban.description}
						</p>

						<!-- Instagram + Detail -->
						<div class="flex flex-wrap items-center gap-3">
							<a
								href={paguyuban.contact.link}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-[#E7C055] bg-[#E7C055] text-s3-blue font-semibold text-sm transition-all duration-200 ease-in-out hover:bg-transparent hover:text-[#E7C055]"
							>
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
									<rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="2"/>
									<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" fill="none" stroke="currentColor" stroke-width="2"/>
									<circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
								</svg>
								{paguyuban.contact.name}
							</a>

							<button
								id="detailBtn"
								class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-[#E7C055] bg-[#E7C055] text-s3-blue font-semibold text-sm transition-all duration-200 ease-in-out hover:bg-transparent hover:text-[#E7C055] cursor-pointer"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								Lihat Detail
							</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Divider -->
		<div class="relative z-20 -mb-12 sm:-mb-24 md:-mb-32">
			<Divider class="-mt-4 md:-mt-16" />
		</div>

		<!-- Content Section: Kegiatan (jika ada) -->
		<section class="py-5 sm:py-20 pb-24 bg-cover bg-center relative z-0 overflow-visible" style="background-color: #76A3ED; background-image: url('/images/elements/bgbatik.webp');">
			<div class="max-w-5xl mx-auto px-4 sm:px-6 md:px-8 relative z-40">
			{paguyuban.events && paguyuban.events.length > 0 && (
				<div class="py-10 sm:py-20">
					<div class="mb-12 text-center flex flex-col items-center relative z-10" data-aos="fade-down" data-aos-duration="800">
						<img src="/images/elements/scroll-above.svg" alt="" class="w-16 sm:w-16 sm:w-20 md:w-28" />
						<h2 class="gradient-text-title font-junigarden-swash text-2xl sm:text-3xl md:text-4xl drop-shadow-[0_2px_0_rgba(0,40,85,1)] leading-tight text-stroke-gold text-center mt-2 sm:mt-4">
							Rangkaian Kegiatan
						</h2>
						<img src="/images/elements/scroll-down.svg" alt="" class="w-16 sm:w-16 sm:w-20 md:w-28 mt-2 sm:mt-4" />
					</div>

					<div class="relative" data-aos="fade-up" data-aos-duration="800" data-aos-delay="200">
						<div class="kegiatan-swiper swiper overflow-visible md:overflow-hidden" style={paguyuban.events.length === 1 ? "display: flex; justify-content: center;" : ""}>
							<div class="swiper-wrapper" style={paguyuban.events.length === 1 ? "justify-content: center;" : ""}>
								{paguyuban.events.map((event, index) => (
									<div class="swiper-slide h-auto py-2" style="width: 158px;" data-aos="fade-up" data-aos-duration="600" data-aos-delay={300 + (index % 3) * 100}>
										<div class="group relative overflow-hidden rounded-2xl bg-[#1e3a5f] p-6 backdrop-blur-sm transition-all duration-300 md:p-8 box-shadow-card hover:box-shadow-card-hover flex flex-col h-80">
												<!-- ornamen sudut, sangat subtle -->
												<svg class="pointer-events-none absolute -right-6 -top-6 h-28 w-28 text-s3-gold opacity-[0.07]" viewBox="0 0 100 100" fill="none">
													<path d="M20 60c10-15 30-15 40 0s30 15 40 0" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
													<path d="M10 40c10-15 30-15 40 0s30 15 40 0" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
												</svg>

												<div class="relative z-10 flex h-full flex-col">
													<h3 class="mb-3 text-xl font-bold leading-snug text-white md:text-2xl">
														{event.title}
													</h3>

													<span class="mb-4 h-[2px] w-10 bg-s3-gold/50 transition-all duration-300 group-hover:w-16"></span>

													{event.description && (
														<div class="flex-1 overflow-y-auto pr-2">
															<p class="text-sm leading-relaxed text-gray-300">
																{event.description}
															</p>
														</div>
													)}
												</div>
											</div>
										</div>
									))}
								</div>
							</div>

							{paguyuban.events.length > 1 && (
								<>
									<button
										class="kegiatan-prev absolute left-0 top-1/2 z-10 hidden -translate-x-14 -translate-y-1/2 h-11 w-11 items-center justify-center rounded-full border border-s3-gold/30 bg-s3-deep-blue/60 text-s3-gold backdrop-blur-sm transition-colors hover:bg-s3-gold hover:text-s3-deep-blue disabled:opacity-30 disabled:pointer-events-none md:flex md:-translate-x-20"
										aria-label="Sebelumnya"
									>
										<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
										</svg>
									</button>
									<button
										class="kegiatan-next absolute right-0 top-1/2 z-10 hidden -translate-y-1/2 translate-x-14 h-11 w-11 items-center justify-center rounded-full border border-s3-gold/30 bg-s3-deep-blue/60 text-s3-gold backdrop-blur-sm transition-colors hover:bg-s3-gold hover:text-s3-deep-blue disabled:opacity-30 disabled:pointer-events-none md:flex md:translate-x-20"
										aria-label="Selanjutnya"
									>
										<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
										</svg>
									</button>
								</>
							)}

							<div class="kegiatan-pagination mt-8 flex justify-center gap-2"></div>
						</div>
					</div>
				)}
			</div>
		</section>

		<!-- Detail Modal -->
		<div
			id="detailModal"
			class="hidden fixed inset-0 z-[999] flex items-center justify-center overflow-y-auto bg-black/70 backdrop-blur-sm p-4"
		>
			<div
				class="modal-panel relative w-full max-w-2xl overflow-hidden rounded-2xl shadow-2xl"
				onclick="event.stopPropagation()"
			>
				<!-- Modal Header - Gold -->
				<div class="relative overflow-hidden bg-[#E7C055] px-6 py-5 md:px-8 md:py-6">
					<!-- subtle texture on header -->
					<div class="pointer-events-none absolute inset-0 opacity-[0.15] [background-image:linear-gradient(#0B1E3D_1px,transparent_1px),linear-gradient(90deg,#0B1E3D_1px,transparent_1px)] [background-size:16px_16px]"></div>

					<div class="relative flex items-start justify-between gap-4">
						<div>
							<h2 class="mt-1 text-3xl md:text-5xl font-bold leading-tight text-s3-blue">
								{paguyuban.name}
							</h2>
						</div>
						<button
							id="closeDetailBtn"
							class="shrink-0 rounded-full bg-white p-2 text-s3-blue shadow-md transition-transform duration-200 hover:scale-110 hover:bg-white/90"
							aria-label="Close modal"
						>
							<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2.5"
									d="M6 18L18 6M6 6l12 12"
								></path>
							</svg>
						</button>
					</div>
				</div>

				<!-- Modal Body - Blue -->
				<div class="max-h-[75vh] overflow-y-auto bg-s3-blue p-6 md:p-8 scroll-bar-hide">
					<div class="space-y-6">
					<div>
						<div class="mb-3 flex items-center gap-2">
							<span class="h-1.5 w-1.5 rounded-full bg-[#E7C055]"></span>
							<h3 class="text-lg font-bold text-white md:text-xl">Detail Paguyuban</h3>
						</div>
							<div class="rounded-xl border border-white/10 bg-white/5 p-4 md:p-5">
								<p class="text-sm leading-relaxed text-white/85 whitespace-pre-wrap md:text-base">
									{paguyuban.longDescription}
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script>
	import Swiper from 'swiper';
	import { Navigation, Pagination } from 'swiper/modules';
	import 'swiper/css';

	document.querySelectorAll('.kegiatan-swiper').forEach((el) => {
		new Swiper(el as HTMLElement, {
			modules: [Navigation, Pagination],
			slidesPerView: 1,
			spaceBetween: 24,
			navigation: {
				nextEl: el.parentElement?.querySelector('.kegiatan-next') as HTMLElement,
				prevEl: el.parentElement?.querySelector('.kegiatan-prev') as HTMLElement,
			},
			pagination: {
				el: el.parentElement?.querySelector('.kegiatan-pagination') as HTMLElement,
				clickable: true,
				bulletClass: 'kegiatan-bullet',
				bulletActiveClass: 'kegiatan-bullet-active',
			},
			breakpoints: {
				768: { slidesPerView: 2 },
				1024: { slidesPerView: 3 },
			},
		});
	});

	const detailBtn = document.getElementById('detailBtn');
	const detailModal = document.getElementById('detailModal');
	const closeDetailBtn = document.getElementById('closeDetailBtn');

	if (detailBtn && detailModal) {
		detailBtn.addEventListener('click', () => {
			detailModal.classList.remove('hidden');
		});

		closeDetailBtn?.addEventListener('click', () => {
			detailModal.classList.add('hidden');
		});

		detailModal.addEventListener('click', (e) => {
			if (e.target === detailModal) {
				detailModal.classList.add('hidden');
			}
		});
	}
</script>

<style>
	main {
		background-attachment: fixed;
	}
</style>

<style is:global>
	.box-shadow-card {
		box-shadow:
			12px 0px 20px -8px rgba(15, 35, 65, 0.4),
			inset 0 2px 4px rgba(255, 255, 255, 0.2);
	}

	.box-shadow-card-hover {
		box-shadow:
			16px 0px 28px -10px rgba(15, 35, 65, 0.5),
			inset 0 2px 6px rgba(255, 255, 255, 0.25);
	}

	.kegiatan-bullet {
		width: 8px;
		height: 8px;
		border-radius: 9999px;
		background: rgba(30, 58, 95, 0.5);
		border: 1px solid rgba(30, 58, 95, 0.7);
		cursor: pointer;
		transition: all 0.3s ease;
	}
	.kegiatan-bullet-active {
		width: 24px;
		border-radius: 9999px;
		background: #1e3a5f;
		border: 1px solid #1e3a5f;
	}

	/* Custom scrollbar untuk deskripsi kegiatan */
	.overflow-y-auto::-webkit-scrollbar {
		width: 6px;
	}

	.overflow-y-auto::-webkit-scrollbar-track {
		background: rgba(255, 255, 255, 0.05);
		border-radius: 3px;
	}

	.overflow-y-auto::-webkit-scrollbar-thumb {
		background: rgba(235, 197, 85, 0.4);
		border-radius: 3px;
		transition: background 0.3s ease;
	}

	.overflow-y-auto::-webkit-scrollbar-thumb:hover {
		background: rgba(235, 197, 85, 0.7);
	}
</style>
