---
import Layout from '../../layouts/Layout.astro';
import ukmData from '../../lib/data/ukm';

export async function getStaticPaths() {
	return ukmData.map(org => ({
		params: { desc: org.id },
		props: { ukm: org }
	}));
}

interface Props {
	ukm: typeof ukmData[0];
}

const { ukm } = Astro.props;
---

<Layout title={`${ukm.name} - Soedirman Student Summit 2026`}>
	<main class="min-h-screen bg-gradient-to-b from-[#1E4B82] to-[#0F1F52]">
		<!-- Hero Section -->
		<section class="relative pt-24 pb-16">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8">
				<!-- Back Button -->
				<a
					href="/ukm"
					class="inline-flex items-center gap-2 text-s3-gold hover:text-white transition-colors mb-8"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
					</svg>
					Kembali
				</a>

				<!-- Hero Content -->
				<div class="flex flex-col md:flex-row items-start gap-8 md:gap-12">
					<!-- Logo -->
					<div class="h-40 w-40 md:h-48 md:w-48 flex-shrink-0">
						<img
							src={ukm.image}
							alt={ukm.name}
							class="h-full w-full object-contain"
						/>
					</div>

					<!-- Info -->
					<div class="flex-1">
						<h1 class="text-4xl md:text-6xl font-reikna font-bold text-white mb-4">
							{ukm.name}
						</h1>
						<p class="text-lg md:text-xl text-gray-300 mb-6 leading-relaxed">
							{ukm.description}
						</p>
						<div class="flex flex-wrap items-center gap-4">
							<span class="inline-block px-4 py-2 text-sm font-medium text-s3-gold bg-s3-gold/10 border border-s3-gold/20 rounded-full capitalize">
								{ukm.slug}
							</span>
							<a
								href={ukm.contact.link}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 px-6 py-2 text-s3-gold border border-s3-gold/20 rounded-full hover:bg-s3-gold/10 transition-colors"
							>
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 2.163c3.204 0 3.584.011 4.85.07 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.059 1.266.07 1.646.07 4.85s-.011 3.585-.07 4.85c-.055 1.17-.249 1.805-.415 2.228-.217.561-.477.96-.896 1.381-.42.419-.819.679-1.38.896-.422.164-1.057.36-2.227.413-1.267.059-1.647.07-4.85.07s-3.584-.011-4.85-.07c-1.17-.055-1.806-.249-2.228-.415-.562-.217-.96-.477-1.382-.896-.419-.42-.679-.819-.896-1.381-.164-.422-.36-1.057-.413-2.227-.059-1.266-.07-1.646-.07-4.85s.011-3.585.07-4.85c.055-1.17.249-1.805.415-2.227.217-.562.477-.96.896-1.382.42-.419.819-.679 1.381-.896.422-.164 1.057-.36 2.227-.413 1.266-.059 1.646-.07 4.85-.07zm0-2.163c-3.259 0-3.667.014-4.947.072-1.275.058-2.148.247-2.913.528-.789.306-1.459.717-2.126 1.384-.667.667-1.079 1.335-1.384 2.126-.281.765-.47 1.638-.528 2.913-.058 1.28-.072 1.688-.072 4.947s.014 3.667.072 4.947c.058 1.275.247 2.148.528 2.913.306.789.717 1.459 1.384 2.126.667.667 1.335 1.079 2.126 1.384.765.281 1.638.47 2.913.528 1.28.058 1.688.072 4.947.072s3.667-.014 4.947-.072c1.275-.058 2.148-.247 2.913-.528.789-.306 1.459-.717 2.126-1.384.667-.667 1.079-1.335 1.384-2.126.281-.765.47-1.638.528-2.913.058-1.28.072-1.688.072-4.947s-.014-3.667-.072-4.947c-.058-1.275-.247-2.148-.528-2.913-.306-.789-.717-1.459-1.384-2.126-.667-.667-1.335-1.079-2.126-1.384-.765-.281-1.638-.47-2.913-.528-1.28-.058-1.688-.072-4.947-.072z"/>
									<circle cx="12" cy="12" r="3.6"/>
								</svg>
								{ukm.contact.name}
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Content Section -->
		<section class="py-20 pb-20">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 md:px-8">
				<!-- Description Section -->
				{ukm.longDescription && (
					<div class="mb-16 p-8 rounded-xl border border-s3-gold/20 bg-gradient-to-br from-s3-blue/40 to-s3-deep-blue/40 backdrop-blur-sm">
						<h2 class="text-3xl font-bold text-s3-gold mb-6">Tentang</h2>
						<p class="text-gray-300 leading-relaxed whitespace-pre-wrap">
							{ukm.longDescription}
						</p>
					</div>
				)}

				<!-- Events Section -->
				{ukm.events && ukm.events.length > 0 && (
					<div class="mb-16">
						<h2 class="text-3xl font-bold text-white mb-8">Program & Kegiatan</h2>
						<div class="space-y-4">
							{ukm.events.map((event) => (
								<div class="p-6 rounded-xl border border-s3-gold/20 bg-gradient-to-br from-s3-blue/40 to-s3-deep-blue/40 backdrop-blur-sm hover:border-s3-gold transition-all duration-300">
									<h3 class="text-xl font-bold text-s3-gold mb-2">
										{event.title}
									</h3>
									{event.description && (
										<p class="text-gray-300">
											{event.description}
										</p>
									)}
								</div>
							))}
						</div>
					</div>
				)}

				<!-- Contact Section -->
				<div class="p-8 rounded-xl border border-s3-gold/20 bg-gradient-to-br from-s3-blue/40 to-s3-deep-blue/40 backdrop-blur-sm">
					<h2 class="text-2xl font-bold text-white mb-6">Hubungi Kami</h2>
					<a
						href={ukm.contact.link}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-3 px-8 py-3 text-lg text-white bg-s3-gold hover:bg-s3-gold/90 rounded-lg transition-colors font-semibold"
					>
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 2.163c3.204 0 3.584.011 4.85.07 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.059 1.266.07 1.646.07 4.85s-.011 3.585-.07 4.85c-.055 1.17-.249 1.805-.415 2.228-.217.561-.477.96-.896 1.381-.42.419-.819.679-1.38.896-.422.164-1.057.36-2.227.413-1.267.059-1.647.07-4.85.07s-3.584-.011-4.85-.07c-1.17-.055-1.806-.249-2.228-.415-.562-.217-.96-.477-1.382-.896-.419-.42-.679-.819-.896-1.381-.164-.422-.36-1.057-.413-2.227-.059-1.266-.07-1.646-.07-4.85s.011-3.585.07-4.85c.055-1.17.249-1.805.415-2.227.217-.562.477-.96.896-1.382.42-.419.819-.679 1.381-.896.422-.164 1.057-.36 2.227-.413 1.266-.059 1.646-.07 4.85-.07zm0-2.163c-3.259 0-3.667.014-4.947.072-1.275.058-2.148.247-2.913.528-.789.306-1.459.717-2.126 1.384-.667.667-1.079 1.335-1.384 2.126-.281.765-.47 1.638-.528 2.913-.058 1.28-.072 1.688-.072 4.947s.014 3.667.072 4.947c.058 1.275.247 2.148.528 2.913.306.789.717 1.459 1.384 2.126.667.667 1.335 1.079 2.126 1.384.765.281 1.638.47 2.913.528 1.28.058 1.688.072 4.947.072s3.667-.014 4.947-.072c1.275-.058 2.148-.247 2.913-.528.789-.306 1.459-.717 2.126-1.384.667-.667 1.079-1.335 1.384-2.126.281-.765.47-1.638.528-2.913.058-1.28.072-1.688.072-4.947s-.014-3.667-.072-4.947c-.058-1.275-.247-2.148-.528-2.913-.306-.789-.717-1.459-1.384-2.126-.667-.667-1.335-1.079-2.126-1.384-.765-.281-1.638-.47-2.913-.528-1.28-.058-1.688-.072-4.947-.072z"/>
							<circle cx="12" cy="12" r="3.6"/>
						</svg>
						Follow {ukm.contact.name}
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		background-attachment: fixed;
	}
</style>
