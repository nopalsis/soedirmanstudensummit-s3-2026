---
import Layout from '../../layouts/Layout.astro';
import UkmCard from '../../components/UkmCard.astro';
import ukmData from '../../lib/data/ukm';

const categories = Array.from(new Set(ukmData.map(org => org.slug))).sort();
---

<Layout title="Unit Kegiatan Mahasiswa (UKM) - Soedirman Student Summit 2026">
	<main class="min-h-screen bg-gradient-to-b from-[#1E4B82] to-[#0F1F52] relative">
		<!-- Hero Section -->
		<section class="relative w-full h-[calc(100vh-var(--nav-height))] flex items-center justify-center bg-gradient-to-b from-[#1E4B82] to-[#0F1F52] bg-cover bg-center px-4 sm:px-6 overflow-visible" style="background-image: url('/images/elements/bgbatik-sambutan.webp');">
			<div class="absolute inset-0 bg-gradient-to-b from-[#1E4B82] to-[#0F1F52] opacity-95"></div>
			<img src="/images/elements/awanbirukuning.png" alt="Awan" class="absolute -bottom-1 left-0 right-0 w-1/2 object-cover object-bottom pointer-events-none z-20" style="transform: translateY(50%);" />
			<img src="/images/elements/ornament1.png" alt="Ornament" class="absolute -bottom-1 left-1/2 -translate-x-1/2 pointer-events-none z-10" style="transform: translateY(60%);" />
			<img src="/images/elements/awanbirukuning.png" alt="Awan" class="absolute -bottom-1 left-0 right-0 w-1/2 object-cover object-bottom pointer-events-none z-20 ml-auto" style="transform: translateY(50%) scaleX(-1);" />
			<div class="absolute top-1/3 -translate-y-1/2 left-1/2 -translate-x-1/2 w-full z-10">
				<div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8">
					<div class="text-center mb-12">
						<h1 class="gradient-text-title font-junigarden-swash text-3xl xs:text-4xl sm:text-5xl md:text-6xl lg:text-6xl drop-shadow-[0_2px_0_rgba(0,0,0,0.2)] mb-6 leading-tight text-stroke-gold">
							Unit Kegiatan Mahasiswa
						</h1>
						<p class="text-white text-sm md:text-base max-w-3xl mx-auto leading-relaxed">
							Unit Kegiatan Mahasiswa (UKM) merupakan wadah bagi Sobat Gensoed untuk mengembangkan potensi, belajar bersama, berbagi informasi, serta saling mendukung dengan sesama mahasiswa yang memiliki minat dan bakat yang sejalan.
						</p>
					</div>

					<!-- Search & Filter Bar -->
					<div class="flex flex-col sm:flex-row gap-4 max-w-4xl mx-auto">
					<!-- Search Bar -->
					<div class="flex-1">
						<div class="relative">
							<svg
								class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-s3-gold"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
								></path>
							</svg>
							<input
								id="searchInput"
								type="text"
								placeholder="Cari UKM yang kamu minati..."
								class="w-full pl-12 pr-4 py-3 rounded-lg border border-s3-gold/20 bg-gradient-to-br from-s3-blue/40 to-s3-deep-blue/40 backdrop-blur-sm text-white placeholder-gray-400 focus:outline-none focus:border-s3-gold transition-colors"
							/>
						</div>
					</div>

					<!-- Filter Dropdown -->
					<div class="relative z-50">
						<button
							id="filterBtn"
							class="w-full sm:w-auto px-6 py-3 rounded-lg border border-s3-gold/20 bg-gradient-to-br from-s3-blue/40 to-s3-deep-blue/40 backdrop-blur-sm text-s3-gold font-medium hover:border-s3-gold transition-colors flex items-center justify-center gap-2"
						>
							Semua Kategori
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
							</svg>
						</button>

						<!-- Dropdown Menu -->
						<div
							id="filterMenu"
							class="hidden absolute right-0 mt-2 w-56 rounded-lg border border-s3-gold/20 bg-gradient-to-br from-s3-blue/90 to-s3-deep-blue/90 backdrop-blur-sm shadow-xl z-50"
						>
							<button
								data-filter="all"
								class="filter-option w-full text-left px-6 py-3 text-s3-gold hover:bg-s3-gold/10 transition-colors first:rounded-t-lg font-medium"
							>
								Semua Kategori
							</button>
							{categories.map(category => (
								<button
									data-filter={category}
									class="filter-option w-full text-left px-6 py-3 text-white hover:bg-s3-gold/10 transition-colors capitalize"
								>
									{category}
								</button>
							))}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Content Section -->
		<section class="py-20 pb-20 bg-cover bg-center" style="background-color: #76A3ED; background-image: url('/images/elements/bgbatik.webp');">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8">

			<!-- Grid -->
			<div id="ukmGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative z-30">
				{ukmData.map((org) => (
					<div
						data-name={org.name}
						data-description={org.description}
						data-slug={org.slug}
						class="ukm-card-wrapper"
					>
						<UkmCard
							image={org.image}
							imageAlt={org.name}
							title={org.name}
							description={org.description}
							href={`/ukm/${org.id}`}
						/>
					</div>
				))}
			</div>

				<!-- Empty State -->
				<div id="emptyState" class="hidden text-center py-12">
					<p class="text-gray-400">Tidak ada UKM yang sesuai dengan pencarian Anda</p>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		background-attachment: fixed;
	}
</style>

<script>
	const searchInput = document.getElementById('searchInput') as HTMLInputElement;
	const filterBtn = document.getElementById('filterBtn') as HTMLButtonElement;
	const filterMenu = document.getElementById('filterMenu') as HTMLElement;
	const filterOptions = document.querySelectorAll('.filter-option');
	const ukmCards = document.querySelectorAll('.ukm-card');
	const resultsCount = document.getElementById('resultsCount');
	const emptyState = document.getElementById('emptyState');
	const ukmGrid = document.getElementById('ukmGrid');

	let currentFilter = 'all';

	filterBtn.addEventListener('click', () => {
		filterMenu.classList.toggle('hidden');
	});

	document.addEventListener('click', (e) => {
		if (!filterBtn.contains(e.target as Node) && !filterMenu.contains(e.target as Node)) {
			filterMenu.classList.add('hidden');
		}
	});

	function filterUKM() {
		const searchTerm = searchInput.value.toLowerCase();
		let visibleCount = 0;

		ukmCards.forEach(card => {
			const name = card.getAttribute('data-name')?.toLowerCase() || '';
			const description = card.getAttribute('data-description')?.toLowerCase() || '';
			const slug = card.getAttribute('data-slug') || '';

			const matchesSearch = name.includes(searchTerm) || description.includes(searchTerm);
			const matchesFilter = currentFilter === 'all' || slug === currentFilter;
			const shouldShow = matchesSearch && matchesFilter;

			if (shouldShow) {
				card.classList.remove('hidden');
				visibleCount++;
			} else {
				card.classList.add('hidden');
			}
		});

		if (visibleCount === 0) {
			ukmGrid!.classList.add('hidden');
			emptyState!.classList.remove('hidden');
		} else {
			ukmGrid!.classList.remove('hidden');
			emptyState!.classList.add('hidden');
		}

		resultsCount!.textContent = `Menampilkan ${visibleCount} dari ${ukmCards.length} UKM`;
	}

	searchInput.addEventListener('input', filterUKM);

	filterOptions.forEach(option => {
		option.addEventListener('click', () => {
			const filter = option.getAttribute('data-filter') || 'all';
			const label = option.textContent || 'Semua Kategori';
			
			filterBtn.textContent = label.trim();
			
			const svg = document.createElement('svg');
			svg.className = 'w-4 h-4';
			svg.setAttribute('fill', 'none');
			svg.setAttribute('stroke', 'currentColor');
			svg.setAttribute('viewBox', '0 0 24 24');
			svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>';
			
			filterBtn.appendChild(svg);
			filterMenu.classList.add('hidden');
			currentFilter = filter;
			filterUKM();
		});
	});
</script>
