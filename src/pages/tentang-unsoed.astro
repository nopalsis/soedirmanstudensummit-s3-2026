  <script>
    // Samain lebar box paragraf Hero ke lebar rendered title (lihat komentar di markup-nya buat
    // kenapa ini gak bisa CSS-murni). Re-ukur pas resize (breakpoint ganti lebar h1) & pas font
    // Junigarden kelar load (kalau diukur sebelum itu, lebar h1 masih pake fallback font, salah).
    function syncHeroParagraphWidth() {
      const title = document.getElementById('hero-title');
      const box = document.getElementById('hero-paragraph-box');
      if (!title || !box) return;

      const titleRect = title.getBoundingClientRect();
      if (titleRect.width > 0) box.style.maxWidth = `${titleRect.width}px`;
    }

    syncHeroParagraphWidth();
    window.addEventListener('resize', syncHeroParagraphWidth);
    document.fonts?.ready.then(syncHeroParagraphWidth);
  </script>

  <script>
    const items = document.querySelectorAll<HTMLButtonElement>('.fakultas-item');
    const titleEl = document.getElementById('fakultas-title');
    const descEl = document.getElementById('fakultas-desc');
    const linkEl = document.getElementById('fakultas-link') as HTMLAnchorElement | null;
    const swatchEl = document.getElementById('fakultas-swatch');

    items.forEach((item) => {
      item.addEventListener('click', () => {
        items.forEach((i) => {
          i.dataset.active = 'false';
          i.classList.remove('font-semibold', 'underline');
        });
        item.dataset.active = 'true';
        item.classList.add('font-semibold', 'underline');

        if (titleEl) titleEl.textContent = item.dataset.title ?? '';
        if (descEl) descEl.textContent = item.dataset.desc ?? '';
        if (linkEl && item.dataset.link) linkEl.href = item.dataset.link;
        if (swatchEl && item.dataset.color) {
          swatchEl.className = `h-4 w-4 shrink-0 rounded-full ${item.dataset.color}`;
        }
      });
    });

    const activeItem = document.querySelector<HTMLButtonElement>('.fakultas-item[data-active="true"]');
    activeItem?.classList.add('font-semibold', 'underline');
  </script>

  <script>
    const hymneAudio = document.getElementById('hymneAudio') as HTMLAudioElement | null;
    const marsAudio = document.getElementById('marsAudio') as HTMLAudioElement | null;
    const bgAudio = document.getElementById('bgMusic') as HTMLAudioElement | null;
    const bgToggleBtn = document.getElementById('btn-play-music');

    function setButtonState(btn: HTMLElement, playing: boolean) {
      btn.querySelector('.play-icon')?.classList.toggle('hidden', playing);
      btn.querySelector('.pause-icon')?.classList.toggle('hidden', !playing);
      const label = btn.querySelector('.audio-label');
      if (label) label.textContent = playing ? 'Pause' : 'Play';
    }

    function bindToggle(
      btn: HTMLElement | null,
      audio: HTMLAudioElement | null,
      other: HTMLAudioElement | null,
      otherBtn: HTMLElement | null
    ) {
      if (!btn || !audio) return;

      btn.addEventListener('click', () => {
        if (audio.paused) {
          if (other && !other.paused) other.pause();
          if (bgAudio && !bgAudio.paused) bgToggleBtn?.click();
          audio.play().catch((err) => console.log('Audio play failed:', err));
        } else {
          audio.pause();
        }
      });

      audio.addEventListener('play', () => {
        setButtonState(btn, true);
        if (otherBtn) setButtonState(otherBtn, false);
      });
      audio.addEventListener('pause', () => setButtonState(btn, false));
      audio.addEventListener('ended', () => setButtonState(btn, false));
    }

    const hymneBtn = document.getElementById('btn-play-hymne');
    const marsBtn = document.getElementById('btn-play-mars');

    bindToggle(hymneBtn, hymneAudio, marsAudio, marsBtn);
    bindToggle(marsBtn, marsAudio, hymneAudio, hymneBtn);
  </script>

  <style>
    /* Swash "V" di judul "Visi" kepotong sisi kiri — root cause BUKAN glyph/overflow/stroke
       (udah dites satu-satu via computed style & isolated render test, semuanya gak clip).
       Penyebab sebenarnya: rule bawaan AOS `[data-aos^="fade"].aos-animate { transform:
       translateZ(0px) }` — residual transform yg dipasang AOS abis animasi kelar (fade-right/
       fade-left), tujuannya cuma force GPU compositing layer buat performa. translateZ(0px)
       NOL efek visual (halaman 2D), tapi bikin Chromium promote elemen itu ke layer sendiri
       yg bound-nya kena hitung dari LAYOUT box, bukan ink/paint box — overshoot swash "V" yg
       nongol di atas cap-height jadi ke-clip ke batas layer itu. "Misi" (huruf M, overshoot
       lebih kecil) kebetulan gak separah itu jadi kelihatan aman.
       Fix: nol-in transform SPESIFIK di state .aos-animate (final, settled) buat 2 wrapper
       ini doang, via id (spesifisitas ngalahin rule AOS `[data-aos^="fade"][data-aos^="fade"]
       .aos-animate` apapun urutan load stylesheet-nya). Gak nyentuh rule pre-animate
       ([data-aos="fade-right"] tanpa .aos-animate) — animasi masuk (translateX awal) tetep
       jalan normal, cuma transform SISA pasca-animasi yg dibuang. Teks gak geser sama sekali
       (translateZ(0) toh gak punya efek visual dari awal). */
    #visi-block[data-aos].aos-animate,
    #misi-block[data-aos].aos-animate {
      transform: none;
    }
  </style>
