          <p class=`${fontClass} text-base sm:text-lg md:text-xl lg:text-2xl tracking-wide`>
            {data} {showYear && <span class="font-love-craft text-sm sm:text-base md:text-lg lg:text-xl align-middle">2026</span>}
          </p>
