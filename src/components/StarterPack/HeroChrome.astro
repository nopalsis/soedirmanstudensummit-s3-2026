---
// Chrome bersama 3 halaman Starter Pack, sumber Figma node 796:40.
import SectionTitle from './SectionTitle.astro';
import BatikOverlay from './BatikOverlay.astro';

interface Props {
	active: 'dresscode' | 'peralatan' | 'dos-donts';
}

const { active } = Astro.props;

const tabs = [
	{ key: 'dresscode', label: 'Dress code', href: '/info-gensoed/starterpack/dresscode' },
	{ key: 'peralatan', label: 'Barang bawaan', href: '/info-gensoed/starterpack/peralatan' },
	{ key: 'dos-donts', label: "Do's & Don'ts", href: '/info-gensoed/starterpack/dos-donts' },
] as const;
---

<section class="relative overflow-hidden bg-[#76a3ed] pt-16 pb-10 md:pt-24">
	<BatikOverlay />

	<img
		src="/images/elements/awan-starterpack.png"
		alt=""
		class="pointer-events-none absolute top-1/2 left-0 z-0 hidden w-56 -translate-y-1/2 md:block lg:w-72"
	/>
	<img
		src="/images/elements/awan-starterpack.png"
		alt=""
		class="pointer-events-none absolute top-1/2 right-0 z-0 hidden w-56 -translate-y-1/2 -scale-x-100 md:block lg:w-72"
	/>

	<div class="relative z-10 mx-auto flex max-w-screen-xl flex-col items-center px-4 text-center">
		<SectionTitle title="Starter Pack" as="h1" />

		<p class="font-plus-jakarta-sans text-white text-lg sm:text-2xl md:text-3xl max-w-3xl" data-aos="fade-up" data-aos-delay="100">
			Panduan lengkap untuk mempersiapkan diri mengikuti Soedirman Student Summit <span class="font-love-craft text-sm sm:text-base md:text-lg">2026</span>
		</p>

		<nav
			aria-label="Navigasi Starter Pack"
			class="mt-8 flex w-full max-w-4xl flex-wrap justify-center gap-3"
			data-aos="fade-up"
			data-aos-delay="200"
		>
			{tabs.map((tab) => (
				<a
					href={tab.href}
					class:list={[
						'font-junigarden-swash flex w-full max-w-[316px] items-center justify-center rounded-[10px] px-4 py-3 text-center text-lg whitespace-nowrap text-[#ffc03f] transition-colors sm:w-auto sm:flex-1 sm:text-2xl md:text-[48px]',
						active === tab.key ? 'bg-[#1d3464]' : 'bg-[rgba(255,255,255,0.25)] hover:bg-[rgba(255,255,255,0.4)]',
					]}
					style="-webkit-text-stroke: 1px #1d3464; paint-order: stroke fill;"
					aria-current={active === tab.key ? 'page' : undefined}
				>
					{tab.label}
				</a>
			))}
		</nav>
	</div>
</section>
