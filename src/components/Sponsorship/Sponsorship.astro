---
const educationalPartners = [
  { name: "BankIndo", img: "/images/sponsors/BankIndo.webp", size: "xl" },
  { name: "Pekan QRIS", img: "/images/sponsors/pekanQRIS.webp", size: "xl" },
];

const sponsorTiers = [
   {
     tier: "xl",
     items: [
       { name: "Almamaters", img: "/images/sponsors/alamamaters.webp", customClass: "max-w-40 sm:max-w-48 md:max-w-56 lg:max-w-64" },
       { name: "Mandiri", img: "/images/sponsors/mandiri.webp", customClass: "max-w-40 sm:max-w-48 md:max-w-[32rem] lg:max-w-[40rem]" },
     ]
   },
  {
    tier: "l-1",
    defaultClass: "max-w-28 sm:max-w-36 md:max-w-44 lg:max-w-52",
    items: [
      { name: "Grab", img: "/images/sponsors/grab.webp" },
      { name: "BTN", img: "/images/sponsors/btn.webp", customClass: "max-w-34 sm:max-w-52 md:max-w-60 lg:max-w-68" },
      { name: "Kai", img: "/images/sponsors/kai.webp", customClass: "max-w-34 sm:max-w-52 md:max-w-60 lg:max-w-68" },
      { name: "Pringsewu", img: "/images/sponsors/pringsewu.webp" },
    ]
  },
  {
    tier: "l-2",
    defaultClass: "max-w-32 sm:max-w-40 md:max-w-48 lg:max-w-56",
    items: [
      { name: "Hydroplus", img: "/images/sponsors/hydroplus.webp" },
      { name: "Paragon Corp", img: "/images/sponsors/paragon.webp", customClass: "max-w-48 sm:max-w-56 md:max-w-64 lg:max-w-72" },
      { name: "Sari Roti", img: "/images/sponsors/sariroti.webp" },
    ]
  },
  {
    tier: "m-1",
    defaultClass: "max-w-24 sm:max-w-28 md:max-w-36 lg:max-w-40",
    items: [
      { name: "Wardah", img: "/images/sponsors/wardah.webp" },
      { name: "Emina", img: "/images/sponsors/emina.webp" },
      { name: "Kahf", img: "/images/sponsors/kahf.webp" },
      { name: "Light Pluss", img: "/images/sponsors/light-pluss.webp" },
      { name: "Pegadaian", img: "/images/sponsors/pegadaian.webp" },
    ]
  },
  {
    tier: "m-2",
    defaultClass: "max-w-20 sm:max-w-24 md:max-w-28 lg:max-w-32",
    items: [
      { name: "Payung Pribadi", img: "/images/sponsors/payuung.webp" },
      { name: "Vica", img: "/images/sponsors/vica.webp" },
      { name: "Artivity", img: "/images/sponsors/artivity.webp" },
      { name: "Arasta", img: "/images/sponsors/arasta.webp" },
      { name: "Bisadaya", img: "/images/sponsors/bisadaya.webp" },
    ]
  },
  {
    tier: "s",
    defaultClass: "max-w-16 sm:max-w-20 md:max-w-24 lg:max-w-28",
    items: [
      { name: "Koi 5", img: "/images/sponsors/koi5.webp" },
      { name: "Advo", img: "/images/sponsors/advo-cafe.webp" },
      { name: "Hangout", img: "/images/sponsors/hangout.webp" },
      { name: "Flowerbar", img: "/images/sponsors/flowerbar.webp" },
      { name: "Bento", img: "/images/sponsors/bento-kopi.webp" },
      { name: "Srawung", img: "/images/sponsors/srawung.webp" },
      { name: "Oronamin C", img: "/images/sponsors/oronamin.webp" },
    ]
  },
  {
    tier: "xs-1",
    defaultClass: "max-w-12 sm:max-w-16 md:max-w-20 lg:max-w-24",
    items: [
      { name: "Gemilang", img: "/images/sponsors/gemilang.webp" },
      { name: "Teras Kita", img: "/images/sponsors/teras.webp" },
      { name: "Serasa", img: "/images/sponsors/serasa.webp" },
      { name: "Meatboss", img: "/images/sponsors/meatboss.webp" },
      { name: "Taman Kopi", img: "/images/sponsors/taman-coffe.webp" },
      { name: "Boersa Kampus", img: "/images/sponsors/boersa-kampus.webp" },
      { name: "Sumringah", img: "/images/sponsors/sumringah.webp" },
    ]
  },
  {
    tier: "xs-2",
    defaultClass: "max-w-12 sm:max-w-16 md:max-w-20 lg:max-w-24",
    items: [
      { name: "Sekala", img: "/images/sponsors/sekala.webp" },
      { name: "Inul Vizta", img: "/images/sponsors/inul-vizta.webp" },
      { name: "Ora Umum", img: "/images/sponsors/waroenk.webp" },
      { name: "Wosly", img: "/images/sponsors/wosly.webp" },
      { name: "Barberich", img: "/images/sponsors/barberich.webp" },
    ]
  }
];
---

<section class="section-padding-x py-16 sm:py-20 md:py-24 text-white-base">
  <div class="container max-w-screen-xl mx-auto">
    <div class="flex flex-col justify-center items-center">
      <!-- Educational Partner Section -->
      <div class="flex flex-col justify-center items-center mb-16 sm:mb-20 md:mb-24">
        <div class="flex flex-col items-center mb-12">
          <img src="/images/elements/scroll-above.svg" alt="" class="w-16 sm:w-20 md:w-28" data-aos="fade-down" data-aos-duration="600" data-aos-delay="100" data-aos-easing="ease-out" data-aos-offset="200" data-aos-once="true" />
           <h2
             class="gradient-text-title text-stroke-gold font-junigarden-swash text-xl sm:text-3xl md:text-4xl drop-shadow-[0_2px_0_rgba(0,40,85,1)] leading-tight text-center mt-4"
             data-aos="fade-down"
             data-aos-duration="600"
             data-aos-delay="200"
             data-aos-easing="ease-out"
             data-aos-offset="200"
             data-aos-once="true"
           >
             Educational Partner
           </h2>
           <img src="/images/elements/scroll-down.svg" alt="" class="w-16 sm:w-20 md:w-28 mt-4" data-aos="fade-up" data-aos-duration="600" data-aos-delay="300" data-aos-easing="ease-out" data-aos-offset="200" data-aos-once="true" />
        </div>
         <div class="flex flex-wrap justify-center gap-2 sm:gap-3 md:gap-4 lg:gap-6">
           {
             educationalPartners.map((partner) => (
                 <span
                    class="flex justify-center items-center max-w-64 sm:max-w-80 md:max-w-96 lg:max-w-[28rem]"
                    data-aos="zoom-in"
                    data-aos-duration="600"
                    data-aos-delay="200"
                    data-aos-easing="ease-out"
                    data-aos-offset="50"
                    data-aos-once="true"
                  >
                    <img src={partner.img} alt={partner.name} class="w-full h-auto object-contain" loading="lazy" decoding="async" />
                  </span>
                ))
              }
           </div>
      </div>

      <!-- Sponsorship Section -->
      <div class="flex flex-col justify-center items-center">
        <div class="flex flex-col items-center mb-12">
          <img src="/images/elements/scroll-above.svg" alt="" class="w-16 sm:w-20 md:w-28" loading="lazy" decoding="async" data-aos="fade-down" data-aos-duration="600" data-aos-delay="100" data-aos-easing="ease-out" data-aos-offset="200" data-aos-once="true" />
           <h2
             class="gradient-text-title text-stroke-gold font-junigarden-swash text-xl sm:text-3xl md:text-4xl drop-shadow-[0_2px_0_rgba(0,40,85,1)] leading-tight text-center mt-4"
             data-aos="fade-down"
             data-aos-duration="600"
             data-aos-delay="200"
             data-aos-easing="ease-out"
             data-aos-offset="200"
             data-aos-once="true"
           >
             Sponsorship
           </h2>
           <img src="/images/elements/scroll-down.svg" alt="" class="w-16 sm:w-20 md:w-28 mt-4" loading="lazy" decoding="async" data-aos="fade-up" data-aos-duration="600" data-aos-delay="300" data-aos-easing="ease-out" data-aos-offset="200" data-aos-once="true" />
        </div>
        
        <!-- Sponsor Tiers -->
        <div class="w-full flex flex-col gap-6 sm:gap-8 md:gap-10">
          {
            sponsorTiers.map((group, groupIndex) => (
              <div class="flex flex-wrap justify-center items-center gap-4 sm:gap-6 md:gap-8 w-full">
                {
                  group.items.map((sponsor, itemIndex) => (
                    <span
                      class={`flex justify-center items-center ${sponsor.customClass || group.defaultClass}`}
                      data-aos="zoom-in"
                      data-aos-duration="600"
                      data-aos-delay={200 + (groupIndex * 100) + (itemIndex * 50)}
                      data-aos-easing="ease-out"
                      data-aos-offset="50"
                      data-aos-once="true"
                    >
                      <img src={sponsor.img} alt={sponsor.name} class="w-full h-auto object-contain" loading="lazy" decoding="async" />
                    </span>
                  ))
                }
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  :global(.scrollbar-hide::-webkit-scrollbar) {
    display: none;
  }

  :global(.shadow-blur) {
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.25));
  }
</style>
