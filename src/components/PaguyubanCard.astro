---
interface Props {
  image: string;
  imageAlt?: string;
  title: string;
  description: string;
  location: string;
  href?: string;
  descriptionWordLimit?: number;
}

const {
  image,
  imageAlt = "",
  title,
  description,
  location,
  href = "#",
  descriptionWordLimit = 15,
} = Astro.props;

const truncateDescription = (text: string, limit: number) => {
  const words = text.split(" ");
  if (words.length > limit) {
    return words.slice(0, limit).join(" ") + "...";
  }
  return text;
};

const truncatedDesc = truncateDescription(description, descriptionWordLimit);
---

<a class="paguyuban-card" href={href}>
  <div class="paguyuban-card__image-wrap">
    <img src={image} alt={imageAlt} class="paguyuban-card__image" loading="lazy" />
  </div>

  <div class="paguyuban-card__body">
    <h3 class="paguyuban-card__title">{title}</h3>
    <p class="paguyuban-card__desc">{truncatedDesc}</p>

    <div class="paguyuban-card__footer">
      <span class="paguyuban-card__location">{location}</span>
      <span class="paguyuban-card__link">
        Lihat Detail
        <svg
          class="paguyuban-card__chevron"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 6 15 12 9 18"></polyline>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .paguyuban-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 320px;
    height: 100%;
    border-radius: 20px;
    background: #1e3a5f;
    text-decoration: none;
    padding: 14px 14px 0 14px;
    box-shadow:
      0 20px 40px -12px rgba(15, 35, 65, 0.5),
      0 8px 16px -6px rgba(15, 35, 65, 0.35),
      inset 0 2px 4px rgba(255, 255, 255, 0.2);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .paguyuban-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 24px 48px -14px rgba(15, 35, 65, 0.6),
      0 10px 20px -8px rgba(15, 35, 65, 0.4),
      inset 0 2px 6px rgba(255, 255, 255, 0.25);
  }

  .paguyuban-card:focus-visible {
    outline: 3px solid #7fb3ff;
    outline-offset: 3px;
  }

  .paguyuban-card__image-wrap {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .paguyuban-card__image {
    width: 95%;
    height: 95%;
    object-fit: contain;
    display: block;
  }

  .paguyuban-card__body {
    padding: 18px 8px 22px;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .paguyuban-card__title {
    margin: 0 0 8px;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .paguyuban-card__desc {
    margin: 0 0 16px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    flex: 1;
  }

  .paguyuban-card__footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .paguyuban-card__location {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: #E7C055;
    background: rgba(231, 192, 85, 0.1);
    border: 1px solid rgba(231, 192, 85, 0.2);
    padding: 4px 8px;
    border-radius: 6px;
    width: fit-content;
  }

  .paguyuban-card__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
    font-size: 1rem;
    color: #ffffff;
  }

  .paguyuban-card__chevron {
    transition: transform 0.2s ease;
  }

  .paguyuban-card:hover .paguyuban-card__chevron {
    transform: translateX(3px);
  }
</style>
